{
  "rules": {
    "staff": {
      ".read": "auth != null",
      "owner": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      },
      "$other": {
        ".validate": "false"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((auth.uid === root.child('staff').child('owner').val() && $uid !== auth.uid) || ($uid === auth.uid && !root.child('staff').child('owner').exists() && newData.parent().parent().child('staff').child('owner').val() === auth.uid))",
        ".validate": "newData.val() === true"
      }
    },
    "roles": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && $uid !== root.child('staff').child('owner').val() && (auth.uid === root.child('staff').child('owner').val() || (root.child('admins').child(auth.uid).exists() && data.val() !== 'admin' && newData.val() !== 'admin'))",
        ".validate": "newData.val() === 'admin' || newData.val() === 'helper' || newData.val() === 'vip'"
      }
    },
    "adminConfig": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && auth.uid === root.child('staff').child('owner').val()"
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "created"
      ],
      "$uid": {
        ".write": "$uid === auth.uid && newData.exists() && auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['name','look','created'])",
        "name": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,16}$/) && (data.exists() ? newData.val() === data.val() : newData.parent().parent().parent().child('usernames').child(newData.val().toLowerCase()).val() === auth.uid)"
        },
        "created": {
          ".validate": "data.exists() ? newData.val() === data.val() : newData.val() === now"
        },
        "motto": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 40"
        },
        "look": {
          ".validate": "newData.hasChildren(['skin','hair','hairStyle','shirt','pants'])",
          "skin": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "hair": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "shirt": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "pants": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "hairStyle": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
          },
          "$other": {
            ".validate": "false"
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists() && !data.exists() && !root.child('users').child(auth.uid).exists()",
        ".validate": "newData.val() === auth.uid && $name.matches(/^[a-z0-9_]{3,16}$/) && newData.parent().parent().child('users').child(auth.uid).child('name').val().toLowerCase() === $name"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $uid && !data.exists() && newData.exists() && auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['coins'])",
        "coins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0 && (root.child('admins').child(auth.uid).exists() || newData.val() === 100)"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "inventory": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    },
    "bans": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists() && $uid !== root.child('staff').child('owner').val() && $uid !== auth.uid && (auth.uid === root.child('staff').child('owner').val() || !root.child('admins').child($uid).exists())",
        ".validate": "newData.hasChildren(['reason','by','t'])",
        "reason": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "byName": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 32"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "players": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "room": {
          ".write": "$uid === auth.uid && auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists()",
          ".validate": "newData.isString() && root.child('rooms').child(newData.val()).exists()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$rid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists() && ((!data.exists() && ($rid === auth.uid + '_0' || $rid === auth.uid + '_1' || $rid === auth.uid + '_2') && newData.child('owner').val() === auth.uid && newData.parent().parent().child('rate').child(auth.uid).child('room').val() === now && (!root.child('rate').child(auth.uid).child('room').exists() || root.child('rate').child(auth.uid).child('room').val() < now - 10000)) || (!newData.exists() && $rid !== 'lobby' && data.child('owner').val() === auth.uid))))",
        ".validate": "newData.hasChildren(['name','owner','ownerName','w','h','door','floor','wall','created'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 30"
        },
        "desc": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
        },
        "owner": {
          ".validate": "newData.isString()"
        },
        "ownerName": {
          ".validate": "newData.isString() && (root.child('admins').child(auth.uid).exists() || newData.val() === root.child('users').child(auth.uid).child('name').val())"
        },
        "w": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 20 && newData.val() % 1 === 0"
        },
        "h": {
          ".validate": "newData.isNumber() && newData.val() >= 4 && newData.val() <= 20 && newData.val() % 1 === 0"
        },
        "door": {
          ".validate": "newData.hasChildren(['x','y']) && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('x').val() >= 0 && newData.child('y').val() >= 0 && newData.child('x').val() < newData.parent().child('w').val() && newData.child('y').val() < newData.parent().child('h').val()",
          "$other": {
            ".validate": "false"
          },
          "x": {
            ".validate": true
          },
          "y": {
            ".validate": true
          }
        },
        "floor": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "wall": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$rid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!newData.exists() && root.child('rooms').child($rid).child('owner').val() === auth.uid && $rid !== 'lobby'))",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && (!newData.exists() || (auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists() && root.child('rooms').child($rid).exists() && root.child('players').child(auth.uid).child('room').val() === $rid))",
          ".validate": "newData.hasChildren(['x','y','d','t']) && newData.child('x').isNumber() && newData.child('y').isNumber() && newData.child('x').val() % 1 === 0 && newData.child('y').val() % 1 === 0 && newData.child('x').val() >= 0 && newData.child('y').val() >= 0 && newData.child('x').val() < root.child('rooms').child($rid).child('w').val() && newData.child('y').val() < root.child('rooms').child($rid).child('h').val() && (data.exists() ? (newData.child('x').val() - data.child('x').val() <= 1 && data.child('x').val() - newData.child('x').val() <= 1 && newData.child('y').val() - data.child('y').val() <= 1 && data.child('y').val() - newData.child('y').val() <= 1 && now - data.child('t').val() >= 200) : (newData.child('x').val() === root.child('rooms').child($rid).child('door').child('x').val() && newData.child('y').val() === root.child('rooms').child($rid).child('door').child('y').val()))",
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "x": {
            ".validate": true
          },
          "y": {
            ".validate": true
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "chat": {
      "$rid": {
        ".read": "auth != null",
        ".indexOn": [
          "t"
        ],
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!newData.exists() && root.child('rooms').child($rid).child('owner').val() === auth.uid && $rid !== 'lobby'))",
        "$mid": {
          ".write": "auth != null && ((auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists() && !data.exists() && newData.child('uid').val() === auth.uid && root.child('players').child(auth.uid).child('room').val() === $rid && newData.parent().parent().parent().child('rate').child(auth.uid).child('chat').val() === now && (!root.child('rate').child(auth.uid).child('chat').exists() || root.child('rate').child(auth.uid).child('chat').val() < now - 1000)) || (!newData.exists() && data.child('t').val() < now - 600000))",
          ".validate": "newData.hasChildren(['uid','name','text','t'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.val() === root.child('users').child(auth.uid).child('name').val()"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "rate": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$k": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now && ($k === 'chat' || $k === 'room' || $k === 'report')"
        }
      }
    },
    "reports": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('roles').child(auth.uid).val() === 'helper')",
      "$id": {
        ".write": "auth != null && ((((root.child('admins').child(auth.uid).exists()) || root.child('roles').child(auth.uid).val() === 'helper') && !newData.exists()) || (auth != null && !root.child('bans').child(auth.uid).exists() && !root.child('economy').child(auth.uid).exists() && !data.exists() && newData.child('by').val() === auth.uid && newData.parent().parent().child('rate').child(auth.uid).child('report').val() === now && (!root.child('rate').child(auth.uid).child('report').exists() || root.child('rate').child(auth.uid).child('report').val() < now - 10000)))",
        ".validate": "newData.hasChildren(['by','type','t'])",
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "type": {
          ".validate": "newData.val() === 'user_report' || newData.val() === 'rule_violation' || newData.val() === 'client_tamper'"
        },
        "byName": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 16"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64"
        },
        "targetName": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 16"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 64"
        },
        "detail": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 300"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "audit": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('roles').child(auth.uid).val() === 'helper') && !data.exists()",
        ".validate": "newData.hasChildren(['by','action','t']) && newData.child('by').val() === auth.uid && newData.child('action').isString() && newData.child('t').val() === now"
      }
    },
    "economy": {
      ".read": "root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || (root.child('admins').child(auth.uid).exists() && !newData.exists()))"
      }
    }
  }
}